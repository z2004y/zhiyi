---
import { getCollection } from 'astro:content';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import PostList from '../components/PostList.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts.filter((post) => post.data.featured).slice(0, 6);
---

<SiteLayout>
  <FeaturedCarousel posts={featured} />

  <div class="section-heading">
    <div>
      <h2 class="section-title">所有文章</h2>
    </div>
    <span class="section-meta">共 {posts.length} 篇</span>
  </div>

  <PostList posts={posts} />
</SiteLayout>
