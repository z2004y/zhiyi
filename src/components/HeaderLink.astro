---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const normalizedHref = typeof href === 'string' ? href.replace(/\/$/, '') || '/' : href;
const isActive = normalizedHref === '/' ? pathname === '/' : pathname.startsWith(normalizedHref);
---

<a href={href} class:list={[className, { 'is-active': isActive }]} {...props}>
  <slot />
</a>
