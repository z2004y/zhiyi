---
import '@waline/client/style';
import { WALINE_CONFIG } from '../consts';

interface Props {
  path?: string;
  title?: string;
}

const { path, title = '评论' } = Astro.props;
const hasServer = Boolean(WALINE_CONFIG.serverURL && WALINE_CONFIG.serverURL.trim());
---

{
  hasServer && (
    <section class="comment-wrap" aria-label="评论区">
      <div class="comment-divider" role="separator" />

      {title && (
        <div class="comment-head">
          <h2 class="comment-title">{title}</h2>
        </div>
      )}

      <div
        id="waline"
        class="waline-box"
        data-server-url={WALINE_CONFIG.serverURL}
        data-path={path || ''}
        data-lang={WALINE_CONFIG.lang}
        data-placeholder={WALINE_CONFIG.placeholder}
        data-pageview={WALINE_CONFIG.pageview ? 'true' : 'false'}
        data-comment={WALINE_CONFIG.comment ? 'true' : 'false'}
        data-pagesize={WALINE_CONFIG.pageSize}
        data-emojis={JSON.stringify(WALINE_CONFIG.emoji)}
      />
    </section>
  )
}

{
  hasServer && (
    <script>
      import { init } from '@waline/client/full';

      let walineInstance: ReturnType<typeof init> | null = null;
      let themeObserver: MutationObserver | null = null;
      let mediaQuery: MediaQueryList | null = null;

      function isDarkMode(): boolean {
        const docTheme = document.documentElement.dataset.theme;
        if (docTheme === 'dark') return true;
        if (docTheme === 'light') return false;
        return window.matchMedia('(prefers-color-scheme: dark)').matches;
      }

      function setupWaline() {
        const el = document.getElementById('waline');
        if (!el) return;

        if (walineInstance) {
          try {
            walineInstance.destroy();
          } catch {
            // ignore
          }
          walineInstance = null;
        }

        const serverURL = el.dataset.serverUrl || '';
        if (!serverURL) return;

        const path = el.dataset.path || window.location.pathname;
        const lang = el.dataset.lang || 'zh-CN';
        const placeholder = el.dataset.placeholder || '说点什么…';
        const pageSize = Number(el.dataset.pagesize) || 10;
        let emoji: string[] = [];
        try {
          emoji = JSON.parse(el.dataset.emojis || '[]');
        } catch {
          emoji = [];
        }

        walineInstance = init({
          el: '#waline',
          serverURL,
          path,
          lang,
          placeholder,
          pageSize,
          dark: isDarkMode(),
          emoji,
          search: false,
          pageview: true,
          comment: true,
          reaction: false,
        });

        if (!themeObserver) {
          themeObserver = new MutationObserver(() => {
            if (walineInstance && typeof walineInstance.update === 'function') {
              walineInstance.update({ dark: isDarkMode() });
            }
          });
          themeObserver.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['data-theme'],
          });
        }

        if (!mediaQuery) {
          mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
          mediaQuery.addEventListener('change', () => {
            if (document.documentElement.dataset.theme === 'auto' && walineInstance) {
              walineInstance.update({ dark: isDarkMode() });
            }
          });
        }
      }

      function teardownWaline() {
        if (walineInstance) {
          try {
            walineInstance.destroy();
          } catch {
            // ignore
          }
          walineInstance = null;
        }
      }

      document.addEventListener('astro:page-load', setupWaline);
      document.addEventListener('astro:before-swap', teardownWaline);

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupWaline);
      } else {
        setupWaline();
      }
    </script>
  )
}

<style>
  .comment-wrap {
    max-width: 760px;
    margin: 3.5rem auto 0;
    padding-inline: 0;
  }

  .comment-divider {
    height: 1px;
    background: var(--c-border);
    margin-bottom: 2rem;
    opacity: 0.6;
  }

  .comment-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .comment-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--c-text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* Waline 样式深度微调，完全契合站点纯净极简风格 */
  .waline-box {
    --waline-theme-color: var(--c-primary);
    --waline-active-color: var(--c-primary-strong);
    --waline-color: var(--c-text-1);
    --waline-bg-color: transparent;
    --waline-bg-color-light: var(--c-bg-2);
    --waline-border-color: var(--c-border);
    --waline-disable-color: var(--c-text-3);
    --waline-info-color: var(--c-text-3);
    --waline-font-size: 0.9375rem;
    --waline-avatar-radius: 50%;
    --waline-badge-color: var(--c-primary);
    --waline-badge-font-size: 0.725rem;
    font-family: var(--font-basic);
  }

  /* 输入面板 */
  :global(.wl-panel) {
    margin: 0 !important;
    border-radius: var(--radius-md) !important;
    border: 1px solid var(--c-border) !important;
    background: var(--c-bg-1) !important;
    box-shadow: none !important;
    transition: border-color var(--motion-fast) var(--ease-out);
  }

  :global(.wl-panel:focus-within) {
    border-color: var(--c-primary) !important;
  }

  :global(.wl-header) {
    border-bottom: 1px solid var(--c-border-soft) !important;
    padding: 0.5rem 0.75rem !important;
  }

  :global(.wl-header label) {
    color: var(--c-text-3) !important;
    font-size: 0.85rem !important;
  }

  :global(.wl-header input) {
    color: var(--c-text) !important;
    font-size: 0.875rem !important;
  }

  :global(.wl-editor) {
    padding: 0.875rem 1rem !important;
    min-height: 5.5rem !important;
    color: var(--c-text) !important;
    font-size: 0.9375rem !important;
    line-height: 1.6 !important;
    background: transparent !important;
  }

  :global(.wl-footer) {
    padding: 0.5rem 0.75rem !important;
    border-top: 1px solid var(--c-border-soft) !important;
  }

  :global(.wl-action) {
    color: var(--c-text-3) !important;
  }

  :global(.wl-action:hover) {
    color: var(--c-primary) !important;
  }

  :global(.wl-btn) {
    border-radius: var(--radius-sm) !important;
    font-size: 0.85rem !important;
    font-weight: 500 !important;
    padding: 0.4rem 1rem !important;
    box-shadow: none !important;
    transition: all var(--motion-fast) var(--ease-out) !important;
  }

  :global(.wl-btn.primary) {
    background: var(--c-primary) !important;
    color: #fff !important;
    border: none !important;
  }

  :global(.wl-btn.primary:hover) {
    background: var(--c-primary-strong) !important;
    opacity: 0.92;
  }

  /* 评论列表 */
  :global(.wl-meta-head) {
    padding: 1.5rem 0 0.5rem !important;
  }

  :global(.wl-count) {
    font-size: 0.9rem !important;
    font-weight: 500 !important;
    color: var(--c-text-2) !important;
  }

  :global(.wl-card) {
    padding-top: 1.25rem !important;
    padding-bottom: 1.25rem !important;
    border-bottom: 1px solid var(--c-border-soft) !important;
  }

  :global(.wl-user) {
    font-weight: 600 !important;
    color: var(--c-text) !important;
  }

  :global(.wl-time) {
    color: var(--c-text-3) !important;
    font-size: 0.8rem !important;
  }

  :global(.wl-content) {
    color: var(--c-text-1) !important;
    line-height: 1.7 !important;
    font-size: 0.9375rem !important;
  }

  :global(.wl-quote) {
    border-left: 3px solid var(--c-border) !important;
    background: var(--c-bg-1) !important;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0 !important;
    padding: 0.5rem 0.85rem !important;
    color: var(--c-text-2) !important;
  }

  /* 底部署名 */
  :global(.wl-power) {
    font-size: 0.75rem !important;
    color: var(--c-text-3) !important;
    padding-top: 1rem !important;
    opacity: 0.6;
  }

  :global(.wl-power a) {
    color: inherit !important;
    text-decoration: underline !important;
    text-underline-offset: 2px !important;
  }
</style>
